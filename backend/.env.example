# Server
ENVIRONMENT=development
PORT=8000
ALLOW_MOCK_AUTH=true

# Firebase (production: set ALLOW_MOCK_AUTH=false)
FIREBASE_PROJECT_ID=tomoni-22782
# Relative to backend/ folder (recommended)
FIREBASE_CREDENTIALS_PATH=credentials/firebase-adminsdk.json
# Or paste full service account JSON on one line
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase Storage (TTS 캐시)
FIREBASE_STORAGE_BUCKET=tomoni-22782.firebasestorage.app

# Gemini (dialogue_provider=gemini 일 때 사용)
GEMINI_API_KEY=
# 대화 품질: gemini-2.5-flash (lite보다 자연스러움)
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (STT + TTS + 대화 엔진 권장)
OPENAI_API_KEY=
# 대화 엔진: openai (권장) | gemini
DIALOGUE_PROVIDER=openai
# gpt-4o-mini (저렴·자연스러움) | gpt-4o (최고 품질)
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
# 기본 목소리(폴백). 세션마다 AI 역할에 따라 alloy/echo/onyx/nova/shimmer 등이 자동 배정됨
OPENAI_TTS_VOICE=nova
